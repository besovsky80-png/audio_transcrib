# Application
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/calls

# Redis
REDIS_URL=redis://redis:6379/0

# Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=calls

# Audio settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=250

# ASR settings
ASR_MODEL=tiny
ASR_DEVICE=cpu

# VAD settings
VAD_THRESHOLD=0.5

# Diarization
ENABLE_DIARIZATION=false

# Security
API_KEY=changeme
REQUIRE_CONSENT=true

# Retention
RETENTION_DAYS=30
